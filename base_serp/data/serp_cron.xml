<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cron Job: SERP Check for Partners -->
        <record id="ir_cron_serp_check_partners" model="ir.cron">
            <field name="name">SERP: Run SERP Check on Partners</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_serp()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron Job: SERP Report Generation for Partners -->
        <record id="ir_cron_serp_report_partners" model="ir.cron">
            <field name="name">SERP Report: Generate SERP Report</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_serp_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>