<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Server Action: Check SERP for Partners -->
    <record id="action_partner_check_serp" model="ir.actions.server">
        <field name="name">Check SERP</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    for record in records:
        if record.serp_provider_id and record.serp_keywords:
            record.action_check_serp()
        </field>
    </record>

</odoo>