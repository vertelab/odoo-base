<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="email_template_serp_report" model="mail.template">
            <field name="name">Website Analytics Report</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="email_from">{{ (object.project_id.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="subject">SERP Report - {{ object.partner_id.name or 'n/a' }} ({{ object.create_date.strftime('%Y-%m-%d') }})</field>
            <field name="description">Sent to customers with their SERP position tracking report</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_id.name or ''">Customer</t>,
        <br /><br />
        Here is your latest SERP position tracking report. This report shows how your keywords are performing in search engine results.
        <br /><br />
        <t t-out="object.description or ''"/>
        <br /><br />
        Do not hesitate to contact us if you have any questions.
        <t t-if="not is_html_empty(user.signature)">
            <br /><br />
            <t t-out="user.signature or ''">--<br/>User</t>
        </t>
    </p>
</div>
            </field>
            <field name="report_template_ids" eval="[]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>