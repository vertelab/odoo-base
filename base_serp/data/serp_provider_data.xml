<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default BeautifulSoup Provider for Google -->
        <record id="serp_provider_beautifulsoup_google" model="serp.provider">
            <field name="name">Google BeautifulSoup</field>
            <field name="provider_type">beautifulsoup</field>
            <field name="search_engine">google</field>
            <field name="sequence">10</field>
            <field name="rate_limit_delay">2.0</field>
            <field name="timeout">10</field>
            <field name="num_results">10</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>