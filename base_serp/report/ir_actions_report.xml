<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_serp_pdf" model="ir.actions.report">
        <field name="name">SERP Position Report (PDF)</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_serp.report_serp_pdf_document</field>
        <field name="report_file">base_serp.report_serp_pdf_document</field>
        <field name="print_report_name">'SERP Report - %s - %s' % (object.partner_id.name, object.create_date.strftime('%Y-%m-%d'))</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
