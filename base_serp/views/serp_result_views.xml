<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_serp_result_form" model="ir.ui.view">
        <field name="name">serp.result.form</field>
        <field name="model">serp.result</field>
        <field name="arch" type="xml">
<!--            create="false" edit="false"-->
            <form string="SERP Result">
                <sheet>
                    <group>
                        <group string="Search Information">
                            <field name="keyword"/>
                            <field name="position"/>
                            <field name="url" widget="url" invisible="1"/>
                            <field name="title"/>
                        </group>
                        <group string="Search Context">
                            <field name="search_date"/>
                            <field name="provider_id" invisible="1"/>
                            <field name="search_engine"/>
                            <field name="country_code"/>
                            <field name="language"/>
                        </group>
                    </group>

                    <group string="Related Record">
                        <field name="resource_ref"/>
                    </group>
                    <group string="Content">
                        <field name="snippet" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_serp_result_list" model="ir.ui.view">
        <field name="name">serp.result.list</field>
        <field name="model">serp.result</field>
        <field name="arch" type="xml">
            <list string="SERP Results" create="false" edit="false">
                <field name="search_date"/>
                <field name="keyword"/>
                <field name="position"/>
                <field name="title"/>
                <field name="url"/>
                <field name="country_code"/>
                <field name="language"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_serp_result_search" model="ir.ui.view">
        <field name="name">serp.result.search</field>
        <field name="model">serp.result</field>
        <field name="arch" type="xml">
            <search string="SERP Results">
                <field name="keyword"/>
                <field name="position"/>
                <field name="search_date"/>
                <field name="provider_id"/>
                <filter string="Today" name="today"
                    domain="[('search_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="This Week" name="this_week"
                    domain="[('search_date', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="This Month" name="this_month"
                    domain="[('search_date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Keyword" name="group_keyword" context="{'group_by': 'keyword'}"/>
                    <filter string="Search Date" name="group_search_date" context="{'group_by': 'search_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

