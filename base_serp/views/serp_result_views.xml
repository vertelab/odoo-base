    <!-- Action -->
    <record id="action_serp_result" model="ir.actions.act_window">
        <field name="name">SERP Results</field>
        <field name="res_model">serp.result</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No SERP results yet
            </p>
            <p>
                Results will appear here after running SERP checks on partners.
            </p>
        </field>
    </record>

