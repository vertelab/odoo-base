<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuration View for SERP Settings -->
    <record id="view_serp_config_settings" model="ir.ui.view">
        <field name="name">serp.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <div id="base_tier_validation">
                    <block title="SERP Tracking" name="base_serp_container">
                        <setting id="module_base_tier_validation_formula">
                            <field name="serp_max_position" />
                            <div class="text-muted">
                                Maximum position to track in SERP results
                            </div>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

