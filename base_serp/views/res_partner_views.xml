<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Form View - SERP Fields -->
    <record id="view_partner_form_serp" model="ir.ui.view">
        <field name="name">res.partner.form.serp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_reports"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-line-chart"
                        invisible="not project_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="serp_report_count" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">SERP Report</span>
                    </div>
                </button>
            </xpath>

            <notebook position="inside">
                <page string="SERP Tracking" name="serp_tracking">
                    <group>
                        <group string="Domain Configuration">
                            <field name="serp_domain" required="1"/>
                        </group>
                        <group string="Provider">
                            <field name="serp_provider_id"/>
                        </group>
                    </group>

                    <group>
                        <group string="Keywords &amp; Countries">
                            <field name="serp_keyword_ids" widget="many2many_tags"/>
                            <field name="serp_country_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Automatic Checking">
                            <field name="project_id"/>
                            <label for="serp_interval_number" string="Check Every"/>
                            <div class="o_row">
                                <field name="serp_interval_number" class="oe_inline"/>
                                <field name="serp_interval_type" class="oe_inline"/>
                            </div>
                            <field name="serp_nextcall"/>
                        </group>
                    </group>

                    <group>
                        <group string="Statistics">
                            <field name="serp_last_check" readonly="1"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>