<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_serp" model="ir.ui.view">
        <field name="name">res.partner.form.serp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- is_serp-checkbox: bara för SERP-behöriga OCH företag (company) -->
            <field name="company_type" position="after">
                <div class="d-inline-flex align-items-center" groups="base_serp.group_serp_user" invisible="company_type != 'company'">
                    <field name="is_serp"/>
                    <label for="is_serp" string="SERP" class="mb-0 ms-1"/>
                </div>
            </field>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_reports"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-line-chart"
                        invisible="not is_serp">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="serp_report_count" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">SERP Report</span>
                    </div>
                </button>
            </xpath>

            <!-- SERP-fliken visas bara för SERP-övervakade kontakter -->
            <notebook position="inside">
                <page string="SERP Tracking" name="serp_tracking" invisible="not is_serp">
                    <group>
                        <group string="SERP Configuration">
                            <field name="serp_provider_id"/>
                            <field name="project_id"/>
                            <field name="serp_report_template_id"/>
                            <field name="serp_last_check" readonly="1"/>
                        </group>
                        <group string="Analytics">
                            <field name="analytics_provider_id"/>
                            <field name="analytics_site_id"/>
                            <field name="analytics_report_template_id"/>
                        </group>
                    </group>

                    <group>
                        <group string="Keywords">
                            <field name="serp_keyword_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="keyword"/>
                                    <field name="country_id"/>
                                    <field name="language_id" context="{'active_test': False}" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                                </list>
                            </field>
                        </group>
                        <group string="Automatic SERP Checking">
                            <label for="serp_interval_number" string="Check Every"/>
                            <div class="o_row">
                                <field name="serp_interval_number" class="oe_inline"/>
                                <field name="serp_interval_type" class="oe_inline"/>
                            </div>
                            <field name="serp_nextcall"/>
                        </group>

                        <group string="Automatic Report Generation">
                            <label for="report_interval_number" string="Generate Every"/>
                            <div class="o_row">
                                <field name="report_interval_number" class="oe_inline"/>
                                <field name="report_interval_type" class="oe_inline"/>
                            </div>
                            <!-- Requirement-fält: krävs endast när is_serp är satt -->
                            <field name="serp_date_range" required="is_serp"/>
                            <field name="report_nextcall"/>
                        </group>

                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
