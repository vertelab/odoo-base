<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_analytics_provider_list" model="ir.ui.view">
        <field name="name">website.analytics.provider.list</field>
        <field name="model">website.analytics.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider_type"/>
                <field name="base_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_website_analytics_provider_form" model="ir.ui.view">
        <field name="name">website.analytics.provider.form</field>
        <field name="model">website.analytics.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider_type"/>
                        </group>
                        <group>
                            <field name="base_url"/>
                            <field name="token_auth" password="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_website_analytics_provider" model="ir.actions.act_window">
        <field name="name">Analytics Providers</field>
        <field name="res_model">website.analytics.provider</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>