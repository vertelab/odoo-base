<odoo>
    <template id="serp_keywords_template">
        <h2 style="margin: 10px 0;">SERP Position Report</h2>

        <!-- Graph Section -->
        <div style="margin: 20px 0;">
            <img t-att-src="'data:image/png;base64,' + graph_image" style="max-width: 100%; height: auto; display: block;"/>
        </div>

        <h3>Keywords Overview</h3>
        <table style="width: 100%; table-layout: fixed; border-collapse: collapse; margin: 20px 0;">
            <thead>
                <tr style="background-color: #f8f9fa;">
                    <th style="padding: 10px; border: 1px solid #ddd; text-align: left; width: 35%;">Keyword</th>
                    <th style="padding: 10px; border: 1px solid #ddd; text-align: center; width: 20%;">Start Position</th>
                    <th style="padding: 10px; border: 1px solid #ddd; text-align: center; width: 20%;">Current Position</th>
                    <th style="padding: 10px; border: 1px solid #ddd; text-align: center; width: 25%;">Change</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="keywords_data" t-as="kw">
                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd; word-wrap: break-word;"><strong t-esc="kw['keyword']"/></td>
                        <td style="padding: 8px; border: 1px solid #ddd; text-align: center;" t-esc="kw['first_position']"/>
                        <td style="padding: 8px; border: 1px solid #ddd; text-align: center;" t-esc="kw['last_position']"/>
                        <td t-attf-style="padding: 8px; border: 1px solid #ddd; text-align: center; color: {{kw['change_class']}};">
                            <t t-if="kw.get('change_icon')" t-esc="kw['change_icon']"/> <t t-esc="kw['change_text']"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>

        <ul>
            <li><strong>Keywords Tracked:</strong> <t t-esc="keywords_list"/></li>
        </ul>
    </template>

    <template id="analytics_template">
<!--        <h3>Website Analytics</h3>-->

        <div id="website_analytics_content"/>
    </template>

    <!-- Main template: Report -->
    <template id="serp_report_content">
        <div style="margin: 0px; padding: 0px;">

            <!-- SERP -->
            <t t-call="base_serp.serp_keywords_template"/>
<!--            <hr/>-->
            <!-- Analytics -->
            <t t-call="base_serp.analytics_template"/>
        </div>
    </template>

    <record id="serp_keywords_template" model="ir.ui.view">
        <field name="is_serp_view" eval="True"/>
    </record>

    <record id="analytics_template" model="ir.ui.view">
        <field name="is_serp_view" eval="True"/>
    </record>

    <record id="serp_report_content" model="ir.ui.view">
        <field name="is_serp_view" eval="True"/>
    </record>
</odoo>