<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!--
      Enrichment bookkeeping, shown on the Accounting-less "Other" page.

      The "Technical Information" page that used to live in this file held the
      ``bw_*`` fields — they belong to partner_builtwith and moved there. A
      view may not reference fields from a module it does not depend on.
    -->
    <record id="view_partner_form_enrich" model="ir.ui.view">
      <field name="name">res.partner.form.enrich</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form" />
      <field name="arch" type="xml">
        <xpath expr="//page[@name='internal_notes']" position="after">
          <page name="enrichment" string="Enrichment"
                groups="base.group_no_one">
            <group name="enrich_meta">
              <group name="enrich_meta_left">
                <field name="enrich_provider" />
                <field name="enrich_fetched_at" />
              </group>
            </group>
            <separator string="Raw provider response" />
            <field name="enrich_raw"
                   widget="ace"
                   options="{'mode': 'python'}"
                   nolabel="1"
                   colspan="2"
                   readonly="1" />
          </page>
        </xpath>
      </field>
    </record>
    <!--
      Mount the autocomplete widget.

      The stock field carries no widget at all in Odoo 18 — it was mounted only
      by the (now deprecated) IAP flow, which nobody in this code base ever
      inherited. Without this inherit the whole suggestion list is unreachable,
      no matter what the Python side does.

      ``position="attributes"`` on the existing field, not a new field:
      redefining it would fight every other module that inherits this form.
    -->
    <record id="view_partner_form_enrich_autocomplete" model="ir.ui.view">
      <field name="name">res.partner.form.enrich.autocomplete</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form" />
      <field name="arch" type="xml">
        <xpath expr="//field[@name='company_registry']" position="attributes">
          <attribute name="widget">field_partner_autocomplete</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
