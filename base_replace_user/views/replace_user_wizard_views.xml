<odoo>
    <data>
        <record id="view_replace_user_wizard" model="ir.ui.view">
            <field name="name">replace.user.wizard.form</field>
            <field name="model">replace.user.wizard</field>
            <field name="arch" type="xml">
                <form string="Replace Users Wizard">
                    <sheet>
                        <group>
                            <field name="old_user_id"/>
                            <field name="new_user_id"/>
                            <field name="model_id"/>
                            <field name="model_name" invisible="1" />
                            <field name="domain" widget="domain" options="{'model': 'model_name', 'foldable': true}" invisible="not model_id"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Replace User" class="btn-primary" name="action_replace_user" type="object" data-hotkey="v"/>
                        <button string="Discard" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_view_replace_user_wizard" model="ir.actions.act_window">
            <field name="name">Replace Users</field>
            <field name="res_model">replace.user.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_replace_user_wizard"/>
            <field name="target">new</field>
        </record>

        <menuitem
            id="menu_action_replace_user"
            name="Replace Users"
            action="action_view_replace_user_wizard"
            parent="account.menu_finance_receivables"
            sequence="800"
            groups="base.group_no_one,account.group_account_manager"/>

    </data>
</odoo>