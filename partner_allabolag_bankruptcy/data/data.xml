<odoo>
    <record id="allabolag_bankruptcy_cron" model="ir.cron">
        <field name="name">Allabolag: Bankruptcy Alert</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.cron_process_bankrupt_companies()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>