<?xml version="1.0"?>
<odoo>

    <record id="calendar_event_view_form" model="ir.ui.view">
        <field name="name">calendar.event.view.form.inherit.booking</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <field name="categ_ids" position="after">
                <field name="booking_type_id" invisible="not booking_type_id"/>
                <field name="booking_status" string="Status" required="booking_type_id" invisible="not booking_type_id"/>
                <field name="resource_ids" options="{'no_create': True}"
                    invisible="not booking_type_id or booking_type_schedule_based_on != 'resources'"
                    domain="[('booking_type_ids', 'in', booking_type_id)]" widget="many2many_tags"/>
                <field name="booking_type_schedule_based_on" invisible="1"/>
                <field name="booking_type_manage_capacity" invisible="1"/>
            </field>
            <xpath expr="//widget[@name='web_ribbon']" position="replace">
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active or booking_type_id"/>
                <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="active or not booking_type_id"/>
            </xpath>
            <xpath expr="//page[@name='page_invitations']" position="after">
                <page name="page_booking" string="Booking Details"
                    invisible="not booking_type_id or booking_type_schedule_based_on != 'resources' or not booking_type_manage_capacity">
                    <field name="booking_line_ids" invisible="not active">
                        <list editable="bottom">
                            <field name="booking_type_id" column_invisible="True"/>
                            <field name="booking_resource_id" domain="[('booking_type_ids', 'in', booking_type_id)]" options="{'no_create': True}"/>
                            <field name="capacity_reserved" sum="Total Capacity Reserved"/>
                            <field name="capacity_used" optional="hide" sum="Total Capacity Used"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="calendar_event_view_tree" model="ir.ui.view">
        <field name="name">calendar.event.view.list.inherit.booking</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration']" position="after">
                <field name="booking_type_id" groups="base.group_no_one"/>
                <field name="booking_resource_ids" widget="many2many_tags" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>

    <record id="calendar_event_view_search" model="ir.ui.view">
        <field name="name">calendar.event.view.search.inherit.booking</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <separator/>
                <filter string="Bookings" domain="[('booking_type_id', '!=', False)]" name="online"/>
                <separator/>
            </xpath>
            <xpath expr="//filter[@name='responsible']" position="after">
                <field name="booking_type_id"/>
                <filter string="Booking Type" name="group_by_booking_type_id" context="{'group_by': 'booking_type_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="calendar_event_view_search_booking" model="ir.ui.view">
        <field name="name">calendar.event.view.search.inherit.booking.booking</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='busy']" position="replace"/>
            <xpath expr="//filter[@name='free']" position="replace"/>
            <xpath expr="//filter[@name='default']" position="replace"/>
            <xpath expr="//filter[@name='public']" position="replace"/>
            <xpath expr="//filter[@name='private']" position="replace"/>
            <xpath expr="//filter[@name='recurrent']" position="replace"/>
            <xpath expr="//filter[@name='online']" position="replace"/>
            <xpath expr="//filter[@name='confidential']" position="replace">
                <field name="booking_status"/>
                <filter string="Cancelled" name="filter_booking_status_cancelled" domain="['&amp;', ('booking_status', '=', 'cancelled'), ('active', '=', False)]"/>
                <filter string="Requests" name="filter_booking_status_request" domain="[('booking_status', '=', 'request')]"/>
                <filter string="Booked" name="filter_booking_status_booked" domain="[('booking_status', '=', 'booked')]"/>
                <filter string="Checked-in" name="filter_booking_status_attended" domain="[('booking_status', '=', 'attended')]"/>
                <filter string="No Show" name="filter_booking_status_no_show" domain="[('booking_status', '=', 'no_show')]"/>
            </xpath>
            <xpath expr="//filter[@name='responsible']" position="before">
                <filter string="Status" name="group_by_booking_status" context="{'group_by': 'booking_status'}"/>
            </xpath>
        </field>
    </record>

    <!-- BOOKING MANAGEMENT -->

    <record id="calendar_event_view_tree_booking" model="ir.ui.view">
        <field name="name">calendar.event.view.list.booking</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <list sample="1" decoration-danger="not active" js_class="booking_booking_list" multi_edit="1">
                <field name="active" column_invisible="True"/>
                <field name="name" string="Subject"/>
                <field name="booking_type_id"/>
                <field name="attendee_ids" string="Booked by" widget="many2many_tags"/>
                <field name="booking_resource_ids" widget="many2many_tags"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="resource_total_capacity_reserved" sum="Total Capacity Reserved"/>
                <field name="resource_total_capacity_used" optional="show" sum="Total Capacity Used"/>
                <field name="booking_status" string="Status"/>
           </list>
        </field>
    </record>

    <record id="calendar_event_view_form_gantt_booking" model="ir.ui.view">
        <field name="name">calendar.event.view.form.gantt.booking</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <form string="Bookings">
                <sheet>
                    <div class="alert alert-warning d-flex flex-wrap" role="alert" invisible="not on_leave_partner_ids">
                        <span class="me-1">Attendees marked as busy at the selected time</span><field name="on_leave_partner_ids" widget="many2many_tags"/>
                    </div>
                    <div class="alert alert-warning d-flex flex-wrap" role="alert" invisible="not on_leave_resource_ids">
                        <field name="booking_resource_ids" invisible="1"/>
                        <span class="me-1">You are scheduling a booking outside the available hours of</span>
                        <field name="on_leave_resource_ids" widget="many2many_tags" readonly="1"/>
                    </div>
                    <div class="oe_title mb-3">
                        <label for="name" string="Booking Name"/>
                        <h1>
                            <field name="name" placeholder='e.g. "John Doe - Tennis Court Booking"' required="True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="booking_status" string="Status" invisible="not booking_type_id" required="booking_type_id"/>
                            <field name="booking_type_id" options="{'no_create': True}" widget="booking_type_sync_duration"/>
                            <label for="start" string="Date"/>
                            <div class="o_row">
                                <field name="start"/>
                                <i class="fa fa-long-arrow-right mx-2" aria-label="Until Icon" title="Arrow"/>
                                <field name="stop"/>
                            </div>
                            <field name="user_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                            <div invisible="not resource_ids or not booking_type_manage_capacity or booking_type_schedule_based_on != 'resources'" colspan="2">
                                <label for="resource_total_capacity_reserved" class="me-5"/>
                                <field name="resource_total_capacity_reserved" string="Total Reserved" class="oe_inline"/>
                                <span>people</span>
                            </div>
                        </group>
                        <group>
                            <field name="partner_ids" widget="many2many_tags_avatar"
                                   placeholder="Select attendees..."
                                   options="{'no_quick_create': True}"
                                   context="{'form_view_ref': 'base.view_partner_simple_form'}"
                                   class="oe_inline o_required_modifier o_field_highlight"  colspan="2"/>
                            <label for="duration"/>
                            <div>
                                <field name="duration" widget="float_time" string="Duration" class="oe_inline"/>
                                <span> hours</span>
                            </div>
                            <field name="booking_type_manage_capacity" invisible="1"/>
                            <field name="booking_type_schedule_based_on" invisible="1"/>
                            <field name="booking_resource_ids" invisible="1"/>
                            <field name="resource_ids" string="Resources" options="{'no_create': True}"
                                   invisible="not booking_type_id or booking_type_schedule_based_on != 'resources'"
                                   domain="[('booking_type_ids', 'in', booking_type_id)]" widget="many2many_tags"/>
                        </group>
                        <field name="description" placeholder="Extra Comments..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" special="save" data-hotkey="s" class="btn btn-primary" close="1"/>
                    <button string="Discard" special="cancel" data-hotkey="j" class="btn-secondary" close="1"/>
                    <button string="Remove" name="unlink" type="object" data-hotkey="x" invisible="not id"
                            class="btn btn-secondary o_form_button_remove" close="1" confirm-title="Delete Booking" confirm-label="Delete Booking"
                            confirm="Are you sure you want to delete this Booking? Once it's gone, it's gone for good!"/>
                </footer>
            </form>
        </field>
    </record>

