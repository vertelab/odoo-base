<?xml version="1.0"?>
<odoo>
    <record id="calendar_alarm_view_form" model="ir.ui.view">
        <field name="name">calendar.alarm.view.form.inherit.booking</field>
        <field name="model">calendar.alarm</field>
        <field name="inherit_id" ref="calendar.calendar_alarm_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='body']" position="after">
                <field name="default_for_new_booking_type"/>
            </xpath>
        </field>
    </record>
</odoo>
