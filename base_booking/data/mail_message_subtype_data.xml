<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mt_calendar_event_booked" model="mail.message.subtype">
        <field name="name">Booking Booked</field>
        <field name="res_model">calendar.event</field>
        <field name="default" eval="False"/>
        <field name="track_recipients" eval="True"/>
        <field name="description">Booking Booked</field>
        <field name="hidden" eval="True"/>
    </record>
    <record id="mt_calendar_event_canceled" model="mail.message.subtype">
        <field name="name">Booking Canceled</field>
        <field name="res_model">calendar.event</field>
        <field name="default" eval="True"/>
        <field name="track_recipients" eval="True"/>
        <field name="description">Booking Canceled</field>
        <field name="hidden" eval="True"/>
    </record>
    <record id="mt_booking_type_booked" model="mail.message.subtype">
        <field name="name">Booking Booked</field>
        <field name="sequence">10</field>
        <field name="res_model">booking.type</field>
        <field name="default" eval="True"/>
        <field name="parent_id" ref="mt_calendar_event_booked"/>
        <field name="relation_field">booking_type_id</field>
    </record>
    <record id="mt_booking_type_canceled" model="mail.message.subtype">
        <field name="name">Booking Canceled</field>
        <field name="sequence">11</field>
        <field name="res_model">booking.type</field>
        <field name="default" eval="True"/>
        <field name="parent_id" ref="mt_calendar_event_canceled"/>
        <field name="relation_field">booking_type_id</field>
    </record>
</odoo>
