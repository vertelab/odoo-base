<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_booking_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
<!--        <field name="category_id" ref="base.module_category_services_booking"/>-->
    </record>

    <record id="group_booking_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids" eval="[(4, ref('base_booking.group_booking_user'))]"/>
<!--        <field name="category_id" ref="base.module_category_services_booking"/>-->
        <!-- base.default_user does not exist in 19.0: base creates the admin
             user, not a default one. The two that do exist are kept. -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
