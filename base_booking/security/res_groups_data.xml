<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="privilege_booking" model="res.groups.privilege">
        <field name="name">Booking</field>
        <field name="sequence">110</field>
    </record>

    <record id="privilege_booking_user" model="res.groups.privilege">
        <field name="name">Booking</field>
        <field name="sequence">110</field>
    </record>

    <record id="privilege_booking_manager" model="res.groups.privilege">
        <field name="name">Booking</field>
        <field name="sequence">110</field>
    </record>

<record id="group_booking_user" model="res.groups">
        <field name="privilege_id" ref="privilege_booking_user"/>
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
<!--        -->
    </record>

    <record id="group_booking_manager" model="res.groups">
        <field name="privilege_id" ref="privilege_booking_manager"/>
        <field name="name">Administrator</field>
        <field name="implied_ids" eval="[(4, ref('base_booking.group_booking_user'))]"/>
<!--        -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
