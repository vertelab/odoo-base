<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- appointment.type -->
    <record id="appointment_type_rule_internal" model="ir.access">
        <field name="name">appointment.type: apt internal rule (read self-staff and resources)</field>
        <field name="model_id" ref="model_appointment_type"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="operation">r</field>
        <field name="domain">[
            '|', '|',
                ('staff_user_ids.id', '=', user.id),
                ('staff_user_ids', '=', False),
                ('schedule_based_on', '=', 'resources')]</field>
    </record>

    <record id="appointment_type_rule_internal_published" model="ir.access">
        <field name="name">appointment.type: apt internal rule (read published)</field>
        <field name="model_id" ref="model_appointment_type"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="operation">r</field>
        <field name="domain">[('is_published', '=', True)]</field>
    </record>

    <record id="appointment_type_rule_user" model="ir.access">
        <field name="name">appointment.type: apt user rule (read self-create, self-staff and resources)</field>
        <field name="model_id" ref="model_appointment_type"/>
        <field name="group_id" ref="appointment.group_appointment_user"/>
        <field name="operation">cr</field>
        <field name="domain">[
            '|', '|', '|',
                ('create_uid', '=', user.id),
                ('staff_user_ids.id', '=', user.id),
                ('staff_user_ids', '=', False),
                ('schedule_based_on', '=', 'resources')]</field>
    </record>

    <record id="appointment_type_rule_user_write_unlink" model="ir.access">
        <field name="name">appointment.type: apt user rule (write/unlink = own only)</field>
        <field name="model_id" ref="model_appointment_type"/>
        <field name="group_id" ref="appointment.group_appointment_user"/>
        <field name="operation">ud</field>
        <field name="domain">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="appointment_type_rule_admin" model="ir.access">
        <field name="name">appointment.type: apt administrator rule</field>
        <field name="model_id" ref="model_appointment_type"/>
        <field name="group_id" ref="appointment.group_appointment_manager"/>
        <field name="operation"></field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>

    <!-- appointment.slot -->
    <record id="appointment_slot_rule_internal" model="ir.access">
        <field name="name">appointment.slot: apt internal rule (read self-staff and resources)</field>
        <field name="model_id" ref="model_appointment_slot"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="operation">r</field>
        <field name="domain">[
            '|', '|',
                ('booking_type_id.staff_user_ids.id', '=', user.id),
                ('booking_type_id.staff_user_ids', '=', False),
                ('booking_type_id.schedule_based_on', '=', 'resources')]</field>
    </record>

    <record id="appointment_slot_rule_internal_published" model="ir.access">
        <field name="name">appointment.slot: apt internal rule (read published)</field>
        <field name="model_id" ref="model_appointment_slot"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="operation">r</field>
        <field name="domain">[('booking_type_id.is_published', '=', True)]</field>
    </record>

    <record id="appointment_slot_rule_user" model="ir.access">
        <field name="name">appointment.slot: apt user rule (read self-create, self-staff and resources)</field>
        <field name="model_id" ref="model_appointment_slot"/>
        <field name="group_id" ref="appointment.group_appointment_user"/>
        <field name="operation">cr</field>
        <field name="domain">[
            '|', '|', '|',
                ('booking_type_id.create_uid', '=', user.id),
                ('booking_type_id.staff_user_ids.id', '=', user.id),
                ('booking_type_id.staff_user_ids', '=', False),
                ('booking_type_id.schedule_based_on', '=', 'resources')]</field>
    </record>

    <!-- Need to explicitly set perms to False to prevent the union between this rule domain and the appointment_slot_rule_user domain at operation -->
    <record id="appointment_slot_rule_user_write_unlink" model="ir.access">
        <field name="name">appointment.slot: apt user rule (write/unlink = own only)</field>
        <field name="model_id" ref="model_appointment_slot"/>
        <field name="group_id" ref="appointment.group_appointment_user"/>
        <field name="operation">ud</field>
        <field name="domain">[
            '|',
                ('booking_type_id.create_uid', '=', user.id),
                ('create_uid', '=', user.id)]</field>
    </record>

    <record id="appointment_slot_rule_admin" model="ir.access">
        <field name="name">appointment.slot: apt administrator rule</field>
        <field name="model_id" ref="model_appointment_slot"/>
        <field name="group_id" ref="appointment.group_appointment_manager"/>
        <field name="operation"></field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>

    <!-- appointment.invite -->
    <record id="appointment_invite_rule_user_internal" model="ir.access">
        <field name="name">appointment.invite: user and internal rule (read self-create and self-staff)</field>
        <field name="model_id" ref="model_appointment_invite"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="group_id" ref="appointment.group_appointment_user"/>
        <field name="operation">cr</field>
        <field name="domain">['|', ('create_uid', '=', user.id), ('staff_user_ids.id', '=', user.id)]</field>
    </record>

    <record id="appointment_invite_rule_user_internal_write_unlink" model="ir.access">
        <field name="name">appointment.invite: apt user and internal rule (write/unlink = own only)</field>
        <field name="model_id" ref="model_appointment_invite"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="group_id" ref="appointment.group_appointment_user"/>
        <field name="operation">ud</field>
        <field name="domain">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="appointment_invite_rule_admin" model="ir.access">
        <field name="name">appointment.invite: apt administrator rule</field>
        <field name="model_id" ref="model_appointment_invite"/>
        <field name="group_id" ref="appointment.group_appointment_manager"/>
        <field name="operation"></field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>
</odoo>
