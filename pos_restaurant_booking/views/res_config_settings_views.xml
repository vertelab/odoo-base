<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_restaurant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pos_restaurant.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='restaurant_section']//setting[@invisible='not pos_module_pos_restaurant or is_kiosk_mode']" position="replace">
                <setting help="Online reservation for restaurant">
                    <field name="pos_module_pos_restaurant_booking" string="Table Booking" />
                    <div class="content-group" id="pos_table_booking" invisible="not pos_module_pos_restaurant_booking">
                        <div class="text-warning mt16 mb4">
                            <label string="Booking type" for="pos_booking_type_id" class="o_light_label me-2"/>
                            <field name="pos_booking_type_id" readonly="pos_has_active_session" />
                        </div>
                    </div>
                </setting>
            </xpath>
<!--            <div id="pos_table_booking" position="replace">-->
<!--                <div class="mt16">-->
<!--                    <label string="Booking type" for="pos_booking_type_id" class="o_light_label me-2"/>-->
<!--                    <field name="pos_booking_type_id" readonly="pos_has_active_session" />-->
<!--                </div>-->
<!--            </div>-->
        </field>
    </record>
</odoo>
