<odoo>
    <data>

        <record id="view_partner_flip_firstname_form" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.flip</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="partner_firstname.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[1]" position="replace">
                    <group invisible="is_company">
                        <field name="firstname" required="not lastname and not is_company and type == 'contact'"/>
                        <field name="lastname" required="not firstname and not is_company and type == 'contact'"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='child_ids']/form//div/group/field[@name='lastname']/.." position="replace">
                    <field name="is_company" invisible="True" />
                    <group invisible="is_company == True">
                        <field name="firstname" required="not lastname and not is_company and type == 'contact'"/>
                        <field name="lastname" required="not firstname and not is_company and type == 'contact'" />
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
