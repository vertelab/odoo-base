<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Artefakttyper för base_ai (okf-mixin D12).
         Bryggan äger sina typer; bridge_module gör taxonomin spårbar. -->
    <record id="artifact_type_partner" model="ai.artifact.type">
        <field name="name">partner</field>
        <field name="kind">knowledge</field>
        <field name="bridge_module">base_ai</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
    </record>
    <record id="artifact_type_company" model="ai.artifact.type">
        <field name="name">company</field>
        <field name="kind">knowledge</field>
        <field name="bridge_module">base_ai</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
    </record>
    <record id="artifact_type_user" model="ai.artifact.type">
        <field name="name">user</field>
        <field name="kind">knowledge</field>
        <field name="bridge_module">base_ai</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'employment', 'retention_days': 0}"/>
    </record>
</odoo>
