<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        OKF-valet i debug-menyn för base_ai (okf-mixin F5.10).

        Åtgärden är generisk och bor i ai_agent_core
        (`ai.okf.mixin.action_open_okf`); här deklareras bara BINDNINGEN.
        `binding_model_id` måste peka på en konkret modell, och modellen
        bor i denna bryggmodul — därför fyra rader XML, ingen Python.

        `base.group_no_one` = debug-läget är på (samma mekanism som
        *Meta data* och *Data*).
    -->
    <record id="action_okf_res_company" model="ir.actions.server">
        <field name="name">OKF</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="binding_model_id" ref="base.model_res_company"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['ai.okf.mixin'].action_open_okf()</field>
    </record>
    <record id="action_okf_res_partner" model="ir.actions.server">
        <field name="name">OKF</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['ai.okf.mixin'].action_open_okf()</field>
    </record>
    <record id="action_okf_res_users" model="ir.actions.server">
        <field name="name">OKF</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['ai.okf.mixin'].action_open_okf()</field>
    </record>
</odoo>
