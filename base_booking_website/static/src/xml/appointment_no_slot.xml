<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-inherit="Booking.booking_info_no_slot" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_booking_no_slot_overall_helper_txt')]" position="inside">
            <div t-if="bookingsCount !== 1" class="text-center">
                <a href="/booking">Go back to Booking</a> or <a href="/contactus">contact us</a>.
            </div>
            <div t-else="" class="text-center">
                <a href="/contactus">Contact us</a>.
            </div>
        </xpath>
    </t>

</templates>
