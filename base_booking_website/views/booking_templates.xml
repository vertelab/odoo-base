<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Templates inherited -->

    <template id="bookings_list_layout" name="Booking: Bookings List Layout"
              inherit_id="base_booking.bookings_list_layout" track="1">
        <xpath expr="//t[@t-call='portal.portal_layout']" position="attributes">
            <attribute name="t-call">website.layout</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_booking_choice')]" position="before">
            <t t-call="base_booking_website.website_calendar_index"/>
        </xpath>
        <xpath expr="//div[hasclass('o_booking_index')]" position="attributes">
            <attribute name="class">o_booking_index bg-o-color-4</attribute>
        </xpath>
        <xpath expr='//div[hasclass("o_booking_svg")]' position="before">
            <div class="alert alert-info text-center d-none" groups="base_booking.group_booking_manager">
                <p class="m-0">Use the top button '<b>+ New</b>' to create an booking type.</p>
            </div>
        </xpath>
    </template>

    <record id="base_booking.bookings_list_layout" model="ir.ui.view">
        <!-- As the track field is not properly overridden (the value is different whether you get it by the base class
        name or the overridden name), write it to the base class as well -->
        <field name="track">1</field>
    </record>

    <template id="booking_info" name="Booking: Booking Info" inherit_id="base_booking.booking_info" track="1">
        <xpath expr="//t[@t-call='portal.portal_layout']" position="attributes">
            <attribute name="t-call">website.layout</attribute>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class">o_wbooking_wrap h-100 overflow-x-hidden</attribute>
        </xpath>
        <xpath expr="//t[@t-set='o_portal_fullwidth_alert']" position="replace"/>
        <xpath expr="//t[@t-call='base_booking.staff_user_select']" position="attributes">
            <attribute name="t-if">
                booking_type.assign_method == 'resource_time' and based_on_users and not skip_resource_selection
            </attribute>
        </xpath>
        <xpath expr="//div[@name='resource_select']" position="attributes">
            <attribute name="t-if">
                booking_type.assign_method == 'resource_time' and not based_on_users and not skip_resource_selection
            </attribute>
        </xpath>
        <xpath expr="//t[@t-call='base_booking.booking_progress_bar']" position="before">
            <a t-if="len(available_bookings) != 1"
                class="text-truncate"
                t-attf-href="/booking?#{keep_query('filter_booking_type_ids', 'filter_staff_user_ids', 'invite_token')}">
                <i class="fa fa-long-arrow-left me-2"/>All Bookings
            </a>
        </xpath>
    </template>

    <record id="base_booking.booking_info" model="ir.ui.view">
        <!-- Write track=1 to the base class as well (see explanation above) -->
        <field name="track">1</field>
    </record>

    <template id="booking_progress_bar" inherit_id="base_booking.booking_progress_bar">
        <xpath expr="//a[contains(@t-att-class, 'step==STEP_TIME')]" position="before">
            <t t-set="STEP_OPERATOR_SELECT" t-value="10"/>
            <t t-set="show_operator_select" t-value="step==STEP_OPERATOR_SELECT or booking_type.avatars_display == 'show' and booking_type.assign_method == 'resource_time' and len(users_or_resources_possible) > 1"/>
            <t t-if="show_operator_select">
                <li class="d-flex align-items-center">
                    <a t-att-class="'text-decoration-none text-truncate ' + (step==STEP_OPERATOR_SELECT and 'fw-bold text-reset cursor-default' or step&gt;STEP_OPERATOR_SELECT and ' ' or 'cursor-default text-muted')"
                       t-att-href="'#' if step&lt;STEP_OPERATOR_SELECT or step==STEP_OPERATOR_SELECT else '/booking/%s?%s' % (booking_type.id, keep_query('filter_booking_type_ids', 'filter_staff_user_ids', 'invite_token'))">
                        <span t-if="booking_type.schedule_based_on == 'users'">Operator</span>
                        <span t-else="">Meeting</span>
                    </a>
                    <span class="d-inline-block mx-sm-3 fa fa-angle-right text-muted fs-5"/>
                </li>
            </t>
        </xpath>
    </template>

    <!-- Pages -->

    <template id="booking_select_operator" name="Booking: Booking Operators">
        <t t-set="no_breadcrumbs" t-value="True"/>
        <t t-call="website.layout">
            <div id="wrap" class="o_wbooking_wrap h-100 overflow-x-hidden">
                <div class="container-lg o_booking o_wbooking_select_operator o_wbooking_type_options h-100" t-att-data-booking-type-id="booking_type.id">
                    <div class="row mt-4">
                        <div class="col-12 col-md-8">
                            <nav class="d-print-none d-flex justify-content-between mb-4">
                                <a t-if="len(available_bookings) != 1"
                                    class="text-truncate"
                                    t-attf-href="/booking?#{keep_query('filter_booking_type_ids', 'filter_staff_user_ids', 'invite_token')}">
                                    <i class="fa fa-long-arrow-left me-2"/>All Bookings
                                </a>
                                <t t-call="booking.booking_progress_bar">
                                    <t t-set="step" t-value="10"/>
                                </t>
                            </nav>
                            <div class="d-flex flex-wrap justify-content-between align-items-center pb-3">
                                <h4 t-if="booking_type.schedule_based_on == 'users'">Choose who you will meet</h4>
                                <a t-attf-href="/booking/#{ booking_type.id }?#{keep_query('*', skip_resource_selection=1)}"
                                    class="o_wbooking_select_btn ms-auto">
                                    <span>See all availabilities <i class="fa fa-long-arrow-right"/></span>
                                </a>
                            </div>
                            <div class="row">
                                <div t-if="booking_type.schedule_based_on == 'users'"
                                    t-foreach="users_possible" t-as="staff_user"
                                    class="col-md-6 col-lg-4 mb-4">
                                    <div class="o_wbooking_card card h-100" itemscope="itemscope" itemtype="http://schema.org/Employee">
                                        <a t-attf-href="/booking/#{booking_type.id}?staff_user_id=#{staff_user.id}&amp;#{keep_query('*')}"
                                        class="d-flex d-md-block h-100 text-reset text-decoration-none">
                                            <header class="o_booking_avatar_container w-25 w-md-auto bg-secondary ratio ratio-4x3">
                                                <div t-attf-style="background-image: url('/booking/#{booking_type.id}/avatar?user_id=#{staff_user.id}');"
                                                    class="o_booking_avatar_background"/>
                                            </header>
                                            <div class="card-body">
                                                <h5 class="mb-1" t-out="staff_user.name"/>
                                                <div class="o_wbooking_card_user_fct mb-2">
                                                    <div t-field="staff_user.partner_id.function" placeholder="Add a function here..."/>
                                                </div>
                                                <div class="o_wbooking_card_user_dsc text-muted small">
                                                    <div t-field="staff_user.partner_id.website_description" placeholder="Add a user description here..."/>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                                <div t-if="booking_type.schedule_based_on == 'resources'"
                                    t-foreach="resources_possible" t-as="resource"
                                    class="col-md-6 col-lg-4 mb-4">
                                    <div class="o_wbooking_card card h-100">
                                        <a t-attf-href="/booking/#{booking_type.id}?#{keep_query('*', resource_selected_id=resource.id)}"
                                            class="text-reset text-decoration-none h-100">
                                            <header class="o_booking_avatar_container bg-secondary ratio ratio-4x3">
                                                <div t-attf-style="background-image: url('/booking/#{booking_type.id}/resource_avatar?resource_id=#{resource.id}');"
                                                    class="o_booking_avatar_background"/>
                                            </header>
                                            <div class="card-body">
                                                <h5 class="mb-0" t-out="resource.name"/>
                                                <div class="o_wbooking_card_user_dsc mb-2 text-muted">
                                                    <div t-field="resource.description" placeholder="Add a resource description here..."/>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                                <!-- Prevent using 'resource' from the loop above as the selected one in other templates -->
                                <t t-set="resource" t-value="False"/>
                            </div>
                            <div class="oe_structure"/>
                        </div>
                        <t t-call="base_booking.booking_details_column"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="bookings_cards_layout" name="Booking Types" track="1">
        <t t-call="website.layout">
            <div id="wrap" class="o_booking_index">
                <div class="oe_structure"/>
                <t t-call="base_booking_website.website_calendar_index"/>
                <t t-call="base_booking_website.website_calendar_index_topbar"/>
                <div class="o_booking_choice o_booking_bookings_list">
                    <div class="container">
                        <div id="o_booking_index_main_col" class="col-md px-0 o_wbooking_booking_list_columns">
                            <div class="row">
                                <t t-call="base_booking_website.bookings_cards"/>
                            </div>
                        </div>
                    </div>
                    <div class="oe_structure oe_empty"/>
                </div>
            </div>
        </t>
    </template>


    <!-- Enable the customize option for the 2 layouts (cards and list)-->
    <template id="website_calendar_index" name="Booking"/>
    <template id="opt_bookings_list_cards" inherit_id="base_booking_website.website_calendar_index" active="True" name="Card Design"/>

    <!-- Top bar -->
    <template id="website_calendar_index_topbar" name="Topbar">
        <nav class="pt-5 pb-4 d-print-none">
            <div class="container">
                <div class="d-flex flex-wrap align-items-center justify-content-between w-100" t-if="booking_types">
                    <h4>Choose your booking</h4>
                    <div class="d-flex w-100 w-md-auto">
                        <t t-call="website.website_search_box_input">
                            <t t-set="_form_classes" t-valuef="w-100 w-md-auto"/>
                            <t t-set="_classes" t-valuef="#{_classes}"/>
                            <t t-set="_input_classes" t-valuef="bg-light"/>
                            <t t-set="_submit_classes" t-valuef="btn-light"/>
                            <t t-set="search_type" t-valuef="bookings"/>
                            <t t-set="action" t-valuef="/booking"/>
                            <t t-set="display_description" t-valuef="true"/>
                            <t t-set="display_detail" t-valuef="false"/>
                            <t t-set="display_image" t-valuef="false"/>
                            <t t-set="placeholder">Search...</t>
                            <t t-set="search" t-value="current_search"/>
                            <t t-foreach="searches" t-as="search">
                                <input t-if="item != 'search' and item_value != 'all'" type="hidden"
                                    t-att-name="item" t-att-value="item_value"/>
                            </t>
                            <input type="hidden" name="filter_booking_type_ids" t-att-value="filter_booking_type_ids"/>
                            <input type="hidden" name="filter_staff_user_ids" t-att-value="filter_staff_user_ids"/>
                            <input type="hidden" name="filter_resource_ids" t-att-value="filter_resource_ids"/>
                            <input type="hidden" name="invite_token" t-att-value="invite_token"/>
                            <t t-out="0"/>
                        </t>
                    </div>
                </div>
            </div>
        </nav>
    </template>

    <template id="bookings_cards" name="Bookings Cards">
        <div t-if="not booking_types" class="col-12 o_booking_not_found">
            <div class="alert alert-info text-center d-none" groups="base_booking.group_booking_manager">
                <p class="m-0">Use the top button '<b>+ New</b>' to create an booking type.</p>
            </div>
            <div class="o_booking_svg mx-auto text-center py-3 w-75">
                <i class="mx-auto h3 fa fa-spinner fa-spin"/>
            </div>
            <div class="mt-4 text-center d-none">
                <t t-if="current_search">
                    <h4>No result for "<t t-out="current_search"/>"</h4>
                    <a href="/booking">See all bookings <i class="fa fa-long-arrow-right"/></a>
                </t>
                <h4 t-else="">There is currently no booking available</h4>
            </div>
        </div>
        <div t-foreach="booking_types" t-as="booking" class="col-md-6 col-lg-4 col-xl-3 mb-4">
            <div class="o_wbooking_card card h-100" itemscope="itemscope" itemtype="http://schema.org/Bookings">
                <a t-attf-href="/booking/#{booking.id}?#{keep_query('filter_booking_type_ids', 'filter_staff_user_ids', 'invite_token')}"
                    class="text-reset text-decoration-none">
                    <t t-call="base_booking_website.booking_card_top"/>
                    <t t-call="base_booking_website.booking_card_body"/>
                </a>
            </div>
        </div>
        <div class="d-flex justify-content-center my-3">
            <t t-call="website.pager"/>
        </div>
    </template>

    <template id="booking_card_top">
        <div class="card-img-top position-relative">
            <div t-field="booking.image_1920" class="d-block h-100 w-100 overflow-hidden ratio ratio-4x3"
                t-options="{'widget': 'image', 'class': 'o_wbooking_cover_image object-fit-cover', 'preview_image': 'image_512'}"/>
            <small t-if="not booking.website_published" class="o_booking_unpublished bg-danger position-absolute w-100 text-end o_cc o_cc3" groups="base.group_user">
                <i class="fa fa-ban me-2"/>Unpublished
            </small>
            <div t-if="booking.assign_method != 'time_auto_assign'" class="o_wbooking_card_staff_users position-absolute bottom-0 d-flex align-items-center ps-2">
                <t t-set="booking_count" t-value="len(booking.staff_user_ids if booking.schedule_based_on == 'users' else booking.resource_ids)"/>
                <t t-if="booking_count" t-call="base_booking_website.booking_resource_description"/>
            </div>
        </div>
    </template>

    <template id="booking_card_body">
        <div class="card-body d-flex flex-column">
            <h5 class="card-title m-0" t-field="booking.name" itemprop="name"/>
            <div itemprop="location" class="o_wbooking_card_location card-text d-flex align-items-center my-2">
                <div class="d-flex" t-if="booking.location_id">
                    <i class="fa fa-map-marker fa-fw me-1 fs-5 text-muted"/>
                    <span t-field="booking.location_id" t-options="{'widget': 'contact', 'fields': ['name']}"/>
                </div>
                <div class="d-flex" t-else="">
                    <i class="fa fa-video-camera fa-fw me-1 fs-5 text-muted"/>
                    <span class="o_not_editable">Online</span>
                </div>
            </div>
            <div class="card-text text-muted">
                <span class="o_wbooking_card_message_intro overflow-hidden" t-field="booking.message_intro" itemprop="message_intro"
                        placeholder="Add an intro message here..."/>
            </div>
        </div>
    </template>

    <template id='booking_resource_description' name="Avatars">
        <t t-if="booking.avatars_display == 'show' and booking.schedule_based_on == 'users'">
            <div t-att-class="booking_count == 1 and 'badge d-flex align-items-center py-0 ps-0 text-bg-light fw-normal rounded-pill' or ''">
                <span class="o_booking_user_avatars d-flex">
                    <t t-foreach="booking.staff_user_ids[:5]" t-as="staff_user">
                        <img t-attf-src="/booking/#{booking.id}/avatar?user_id=#{staff_user.id}&amp;avatar_size=128" t-att-title="staff_user.name"
                            class="rounded-circle o_booking_avatar_background o_booking_user_avatar"/>
                    </t>
                    <span t-if="booking_count == 6" class="rounded-circle o_booking_user_avatar d-flex align-items-center justify-content-center bg-light"> +1 </span>
                    <span t-if="booking_count > 6" class="rounded-circle o_booking_user_avatar d-flex align-items-center justify-content-center bg-light"> +<t t-out="booking_count - 5"/></span>
                </span>
                <span t-if="booking_count == 1"><t t-out="booking.staff_user_ids[0].name"/></span>
            </div>
        </t>
    </template>

</odoo>
