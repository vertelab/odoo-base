<odoo>
    <data>
        <record id="view_anonymization_rule_form" model="ir.ui.view">
            <field name="name">anonymization.rule.form</field>
            <field name="model">anonymization.rule</field>
            <field name="arch" type="xml">
                <form string="Account">
                    <header>
                        <button name="action_anonymize" string="Run Anonymization" class="oe_highlight" type="object"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="model_name" invisible="1" />
                            <field name="domain" widget="domain" options="{'model': 'model_name', 'foldable': true}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_anonymization_rule_list" model="ir.ui.view">
            <field name="name">anonymization.rule.list</field>
            <field name="model">anonymization.rule</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="model_id"/>
                </list>
            </field>
        </record>

        <record id="action_anonymization_rule" model="ir.actions.act_window">
            <field name="name">Anonymization Rule</field>
            <field name="res_model">anonymization.rule</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="menu_anonymization_rule"
            name="Anonymization Rule"
            parent="base.menu_administration"
            sequence="50"
            action="action_anonymization_rule"
            groups="base.group_system"/>
    </data>
</odoo>