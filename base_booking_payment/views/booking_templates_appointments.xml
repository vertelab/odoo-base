<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="booking_info" inherit_id="base_booking.booking_meeting_details">
    <xpath expr="//div[hasclass('o_booking_details_location')]" position="before">
        <div t-if="booking_type.product_id" class="d-flex py-1 px-0 bg-transparent o-cc1-text border-0">
            <t t-set="isDetailsManageCapacity" t-value="booking_type.resource_manage_capacity and isDetails"/>
            <i class="fa fa-credit-card fa-fw me-2 mt-1 text-muted"/>
            <span class="o_booking_details_price">
                <t t-out="booking_type.product_lst_price * asked_capacity if isDetailsManageCapacity else booking_type.product_lst_price"
                    t-options="{'widget': 'monetary', 'display_currency': booking_type.product_currency_id}"/>
            </span>
            <span t-if="booking_type.resource_manage_capacity and not isDetails" class="ms-1">per seat</span>
        </div>
    </xpath>
</template>
</odoo>
