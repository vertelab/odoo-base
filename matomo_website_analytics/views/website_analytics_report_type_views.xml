<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_analytics_report_type_form_matomo" model="ir.ui.view">
        <field name="name">website.analytics.report.type.form.matomo</field>
        <field name="model">website.analytics.report.type</field>
        <field name="inherit_id" ref="base_serp.view_website_analytics_report_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[last()]" position="after">
                <group>
                    <group string="API Configuration">
                        <field name="api_module"/>
                        <field name="api_action"/>
                    </group>
                    <group string="Graph Configuration">
                        <field name="graph_type"/>
                        <field name="width"/>
                        <field name="height"/>
                    </group>
                    <group string="Report Filters">
                        <field name="period"/>
                        <field name="date"/>
                        <field name="last_n"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
