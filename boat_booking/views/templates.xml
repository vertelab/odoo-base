<odoo>

    <template id="booking_info_maps" inherit_id="base_booking.booking_info">
        <xpath expr="//div[@id='wrap']/div[hasclass('booking-container')]" position="after">
            <div class="container-lg mt-4 h-auto" t-if="booking_type.booking_type == 'boat'">

               <section class="s_booking_map pt256 pb256" t-att-data-booking-type-id="booking_type.id" data-map-type="ROADMAP" data-map-color="" data-map-zoom="12" data-pin-style="flat" t-att-data-map-id="request.website.map_id" style="position: relative;">
                   <div class="map_container"></div>
               </section>
                <div class="mb-4"/>
            </div>
        </xpath>
    </template>

    <template id="booking_info" inherit_id="base_booking.booking_info">
        <xpath expr="//div[hasclass('o_booking_info_main')]" position="after">
            <input type="hidden" name="booking_type" t-att-value="booking_type.booking_type or 'other'"/>
        </xpath>
    </template>

    <template id="booking_form_append_dimensions" inherit_id="base_booking.booking_form">
        <xpath expr="//form[contains(@class,'booking_submit_form')]" position="inside">
            <input type="hidden" name="length" t-att-value="request.params.get('length') or request.params.get('boat_length')"/>
            <input type="hidden" name="width" t-att-value="request.params.get('width') or request.params.get('boat_width')"/>
            <input type="hidden" name="depth" t-att-value="request.params.get('depth') or request.params.get('boat_depth')"/>
        </xpath>
    </template>
</odoo>