<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Marina / Harbor address used as booking.type location -->
    <record id="boat_marina_address" model="res.partner">
        <field name="name">City Marina</field>
        <field name="is_company" eval="True"/>
        <field name="street">Harbor Street 1</field>
        <field name="city">Linköping</field>
        <field name="zip">58222</field>
        <field name="country_id" ref="base.se"/>
    </record>

    <record id="booking_type_boat" model="booking.type">
        <field name="name">Boat Rental</field>
        <field name="location_id" ref="boat_marina_address"/>
        <field name="booking_duration">2</field>
        <field name="max_schedule_days">14</field>
        <field name="schedule_based_on">resources</field>
        <field name="assign_method">time_auto_assign</field>
        <field name="resource_manage_capacity" eval="True"/>
        <field name="booking_manual_confirmation" eval="True"/>
        <field name="resource_manual_confirmation_percentage">0.8</field>
        <field name="message_partner_ids" eval="[(6, 0, [ref('base.partner_admin')])]"/>
        <field name="event_videocall_source" eval="False"/>
        <field name="is_published" eval="True"/>
        <field name="hide_timezone" eval="True"/>
        <field name="hide_duration" eval="True"/>
        <!-- Demo availabilities: Wed-Sun evenings; Wed/Sat/Sun midday -->
        <field name="slot_ids" eval="[(5, 0, 0)] + [
            (0, 0, {'weekday': weekday, 'start_hour': start_hour, 'end_hour': start_hour + 2.0})
            for weekday in ('3', '4', '5', '6', '7')
            for start_hour in (19, 19.50, 20)
        ] + [
            (0, 0, {'weekday': weekday, 'start_hour': start_hour, 'end_hour': start_hour + 2.0})
            for weekday in ('3', '6', '7')
            for start_hour in (12, 12.50)
        ]"/>
    </record>

    <!-- Boats with coordinates -->
    <record id="booking_type_boat_table_01" model="booking.resource">
        <field name="name">Speed Boat A</field>
        <field name="capacity">4</field>
        <field name="booking_type_ids" eval="[(6, 0, [ref('booking_type_boat')])]"/>
        <field name="latitude">58.410043</field>
        <field name="longitude">15.621372</field>
    </record>

