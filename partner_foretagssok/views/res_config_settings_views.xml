<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.foretagssok</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='contacts_settings']/block" position="inside">
                <setting id="foretagssok_setting" string="FöretagsAPI" help="Configure access to FöretagsAPI.se">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="foretagssok_api_key" string="API Key" class="col-lg-3 o_light_label"/>
                            <field name="foretagssok_api_key" password="True" class="oe_inline"/>
                        </div>
                        <div class="row">
                            <label for="foretagssok_base_url" string="Base URL" class="col-lg-3 o_light_label"/>
                            <field name="foretagssok_base_url" class="oe_inline"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
