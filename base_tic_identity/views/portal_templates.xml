<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="tic_identity_messages" inherit_id="portal.portal_my_details_fields">
        <xpath expr="//input[@name='csrf_token']" position="after">
            <div t-if="tic_verified" class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa fa-check-circle me-2"/>
                <strong>Success!</strong> Your identity has been verified with BankID.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
            </div>

            <div t-if="tic_error" class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                <strong>Error!</strong> Identity verification failed. Please try again or contact support.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
            </div>
        </xpath>
    </template>

     <template id="tic_identity_portal_my_details" inherit_id="portal.portal_my_details">
         <xpath expr="//div[hasclass('clearfix', 'text-end', 'mb-5')]/a[1]" position="before">
              <a href="/tic/verify-identity" class="btn btn-primary">
                 Verify Identity
              </a>
         </xpath>
     </template>
</odoo>
