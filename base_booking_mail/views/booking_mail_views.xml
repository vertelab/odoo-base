<odoo>
    <data>

        <record id="booking_mail_view_form" model="ir.ui.view">
            <field name="name">booking_mail_form</field>
            <field name="model">booking.mail</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="booking_type_id"/>
                                <field name="template_ref" options="{'no_quick_create': True}"/>
                                <field name="mail_state"/>
                            </group>
                            <group>
                                <label for="interval_nbr"/>
                                <div class="o_row">
                                    <field name="interval_nbr" invisible="interval_unit == 'now'" readonly="interval_unit == 'now'"/>
                                    <field name="interval_unit"/>
                                </div>
                                <field name="interval_type"/>
                            </group>
                        </group>
                        <notebook groups="base.group_no_one">
                            <page string="Registration Mails" name="registration_mails">
                                <field name="booking_mail_calendar_ids">
                                    <list string="Registration mail" editable="bottom">
                                        <field name="partner_ids" widget="many2many_tags"/>
                                        <field name="scheduled_date"/>
                                        <field name="mail_done" string="Sent"/>
                                        <field name="mail_count_done"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="booking_mail_view_list" model="ir.ui.view">
            <field name="name">booking_mail_list</field>
            <field name="model">booking.mail</field>
            <field name="arch" type="xml">
                <list string="Mail Bookings">
                    <field name="booking_type_id" on_change="1"/>
                    <field name="template_ref" options="{'no_quick_create': True}" /> <!--context="{'filter_template_on_event': True, 'default_model': 'event.registration'}" widget="EventMailTemplateReferenceField"-->
                    <field name="scheduled_date"/>
                    <field name="mail_count_done"/>
                    <field name="mail_state" widget="event_icon_selection" string=" " nolabel="1" options="{'sent': 'fa fa-check', 'scheduled': 'fa fa-hourglass-half', 'running': 'fa fa-cogs'}"/>
                </list>
            </field>
        </record>

        <record id="booking_mail_action" model="ir.actions.act_window">
            <field name="name">Mail Bookings</field>
            <field name="path">mail_bookings</field>
            <field name="res_model">booking.mail</field>
            <field name="view_mode">list,form</field>
            <field name="domain"></field>
            <field name="context"></field>
        </record>

    </data>
</odoo>
