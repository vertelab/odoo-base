<odoo>
  <data>

    <record id="booking_type_view_form" model="ir.ui.view">
      <field name="name">booking.type.mail.form</field>
      <field name="model">booking.type</field>
      <field name="inherit_id" ref="base_booking.booking_type_view_form"/>
      <field name="arch" type="xml">
        <page name="messages" position="after">
          <page string="Communication" name="booking_communication">
            <field name="booking_mail_ids">
              <list string="Communication" editable="bottom">
                <field name="sequence" widget="handle"/>
                 <field name="template_ref" options="{'no_quick_create': True}" /> <!-- context="{'filter_template_on_event': True, 'default_model': 'event.registration'}" widget="EventMailTemplateReferenceField" -->
                <field name="interval_nbr" readonly="interval_unit == 'now'"/>
                <field name="interval_unit"/>
                <field name="interval_type"/>
                <field name="scheduled_date" groups="base.group_no_one"/>
                <field name="mail_count_done"/>
                <field name="mail_state" widget="event_icon_selection" string=" " nolabel="1" options="{'sent': 'fa fa-check', 'scheduled': 'fa fa-hourglass-half', 'running': 'fa fa-cogs'}"/>
              </list>
            </field>
          </page>
        </page>
      </field>
    </record>

  </data>
</odoo>