<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.cron" forcecreate="True" id="booking_mail_scheduler">
            <field name="name">Booking: Mail Scheduler</field>
            <field name="model_id" ref="model_booking_mail_calendar"/>
            <field name="state">code</field>
            <field name="code">model.cron_run()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>

    </data>
</odoo>
